{
  "rules": {
    "setupComplete": {
      ".read": "auth != null",
      ".write": "auth != null && data.val() !== true"
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('setupComplete').val() !== true && auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "campaigns": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": [
        "createdAt"
      ]
    }
  }
}